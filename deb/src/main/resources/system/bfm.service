[Unit]
Description=BFM Service
After=network.target

[Service]
Type=forking

User=postgres
Group=postgres
WorkingDirectory=/etc/bfm/bfmwatcher

# Shell script'inin oluşturduğu PID dosyasını Systemd'ye bildiriyoruz
PIDFile=/etc/bfm/bfmwatcher/bfm.pid

ExecStart=/etc/bfm/bfmwatcher/bfm.sh start
ExecStop=/etc/bfm/bfmwatcher/bfm.sh stop
ExecReload=/etc/bfm/bfmwatcher/bfm.sh restart

# Uygulama çökerse veya beklenmedik şekilde durursa yeniden başlat
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target